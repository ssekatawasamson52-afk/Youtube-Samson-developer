<!doctype html>
<html>
  <head>
    <title>YouTube</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
      /*Responsive design*/
      *{
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body{
        width: 100%;
        overflow-x: hidden; /* lock page sideways scroll */
        font-family: Arial, sans-serif;
      }
      header{
        width: 100%;
        height: 60px;
        display: flex;
        justify-content: space-between; /* fixed: was flex-direction */
        align-items: center;
        background: white;
        padding: 0 16px;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      #img{
        color: red;
        margin-right: 8px;
      }
      #title{
        font-size: 20px;
      }
      .icon{
        display: flex;
        gap: 24px;
        font-size: 20px;
      }
      .home{
        width: 100%;
      }
      .filter-bar{
        width: 100%;
        display: flex;
        gap: 12px;
        padding: 12px 16px; /* use padding instead of margin-left */
        overflow-x: auto; /* Scroll on phone*/
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none; /* hide scrollbar Firefox */
      }
      .filter-bar::-webkit-scrollbar {
        display: none; /* hide scrollbar Chrome */
      }
      .filter-btn{
        padding: 8px 16px;
        border-radius: 16px; /* rounder like YouTube */
        border: none;
        background: #f2f2f2; /* light gray like YouTube */
        color: #000;
        font-weight: 500;
        cursor: pointer;
        flex-shrink: 0; /* IMPORTANT: stops buttons from breaking layout */
      }
      .content{
        width: 100%;
        aspect-ratio: 16/9; /* YouTube video ratio - perfect */
        position: relative;
        overflow: hidden;
        border-radius: 10px;
        margin-bottom: 12px;
      }
      #movie{
        width: 100%;
        height: 100%;
        object-fit: cover; /* crops perfectly, no stretch */
        display: block;
      }
      .video-grid{
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 24px 16px;
        padding: 24px 16px;
      }
      .home{
        width: 100%;
      }
      .duration{
        position: absolute;
        bottom: 8px;
        right: 8px;
        background: rgba(0,0,0,0.8);
        color: white;
        padding: 3px 6px;
        border-radius: 5px;
        font-weight: bold;
        font-size: 12px;
      }
      .video-title{
        margin-bottom: 8px;
        font-weight: 800px;
        font-size: 14px;
      }
      @media (max-width: 600px){
        .video-grid{
          grid-template-columns: 1fr;
          gap: 20px;
          padding: 16px;
        }
      }
    </style>
  </head>
  <body>
    <!--header-->
    <header>
      <div style="display:flex; align-items:center;">
        <i class="fa-brands fa-youtube fa-2x" id="img"></i>
        <h2 id="title">YouTube</h2>
      </div>
      <div class="icon">
        <i class="fa-solid fa-bell"></i>
        <i class="fa-solid fa-search"></i>
      </div>
    </header>
    
    <div class="filter-bar">
      <button class="filter-btn active">All</button>
      <button class="filter-btn">Coding</button>
      <button class="filter-btn">Movies</button>
      <button class="filter-btn">Sports</button>
      <button class="filter-btn">Hollywood</button>
      <button class="filter-btn">Music</button>
      <button class="filter-btn">Cartoon</button>
      <button class="filter-btn">News</button>
    </div>
    
    <!--home-->
    <main>
     <div class="video-grid">
        <div class="home">
        <div class="content">
          <img src="IMG-20260801-WA0012.jpg" id="movie">
          <span class="duration">24:34</span>
        </div>
        <p class="video-title">Learning website Programming </p>
      </div>
      
       <div class="home">
        <div class="content">
          <img src="IMG-20260801-WA0012.jpg" id="movie">
        </div>
      </div>
       <div class="home">
        <div class="content">
          <img src="IMG-20260801-WA0012.jpg" id="movie">
        </div>
      </div>
      
     </div>
    </main>
  </body>
</html>
